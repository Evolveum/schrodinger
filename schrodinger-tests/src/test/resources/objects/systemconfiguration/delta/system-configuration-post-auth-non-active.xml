<!-- Applied on top of the initial system configuration, see AbstractSchrodingerTest.applySystemConfiguration(). -->
<apti:objectModification xmlns:apti="http://midpoint.evolveum.com/xml/ns/public/common/api-types-3" xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3" xmlns:c="http://midpoint.evolveum.com/xml/ns/public/common/common-3" xmlns:org="http://midpoint.evolveum.com/xml/ns/public/common/org-3" xmlns:q="http://prism.evolveum.com/xml/ns/public/query-3" xmlns:t="http://prism.evolveum.com/xml/ns/public/types-3" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <apti:oid>00000000-0000-0000-0000-000000000001</apti:oid>
    <apti:itemDelta>
        <t:modificationType>add</t:modificationType>
        <t:path>c:defaultObjectPolicyConfiguration</t:path>
        <t:value xsi:type="c:ObjectPolicyConfigurationType">
            <lifecycleStateModel>
                <state>
                    <name>proposed</name>
                    <forcedAssignment>
                        <targetType>RoleType</targetType>
                        <filter>
                            <q:equal>
                                <q:matching>polyStringNorm</q:matching>
                                <q:path>name</q:path>
                                <q:value>Post authentication authorization role</q:value>
                            </q:equal>
                        </filter>
                    </forcedAssignment>
                    <activeAssignments>false</activeAssignments>
                </state>
                <state>
                    <name>draft</name>
                    <forcedActivationStatus>archived</forcedActivationStatus>
                </state>
            </lifecycleStateModel>
            <type>UserType</type>
            <subtype>employee</subtype>
        </t:value>
    </apti:itemDelta>
</apti:objectModification>
