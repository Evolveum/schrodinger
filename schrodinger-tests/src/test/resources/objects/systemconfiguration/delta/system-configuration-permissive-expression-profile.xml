<!-- Applied on top of the initial system configuration, see AbstractSchrodingerTest.applySystemConfiguration(). -->
<!-- Some test objects keep Groovy scripts, either because MEL cannot replace them or because they cover a ticket.
     Groovy is denied by the default expression profiles of these object types (safe, reporting, configuration),
     so the permissive profile is used instead. Test classes using such objects return this delta from
     getSystemConfigurationDeltas(). -->
<apti:objectModification xmlns:apti="http://midpoint.evolveum.com/xml/ns/public/common/api-types-3" xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3" xmlns:c="http://midpoint.evolveum.com/xml/ns/public/common/common-3" xmlns:t="http://prism.evolveum.com/xml/ns/public/types-3">
    <apti:oid>00000000-0000-0000-0000-000000000001</apti:oid>
    <apti:itemDelta>
        <t:modificationType>delete</t:modificationType>
        <t:path>c:defaultObjectPolicyConfiguration</t:path>
        <t:value>
            <type>RoleType</type>
            <expressionProfile>safe</expressionProfile>
        </t:value>
        <t:value>
            <type>ObjectCollectionType</type>
            <expressionProfile>safe</expressionProfile>
        </t:value>
        <t:value>
            <type>AccessCertificationDefinitionType</type>
            <expressionProfile>safe</expressionProfile>
        </t:value>
        <t:value>
            <type>AccessCertificationCampaignType</type>
            <expressionProfile>safe</expressionProfile>
        </t:value>
        <t:value>
            <type>ReportType</type>
            <expressionProfile>reporting</expressionProfile>
        </t:value>
        <t:value>
            <type>ObjectTemplateType</type>
            <expressionProfile>configuration</expressionProfile>
        </t:value>
        <t:value>
            <type>SystemConfigurationType</type>
            <expressionProfile>configuration</expressionProfile>
        </t:value>
    </apti:itemDelta>
    <apti:itemDelta>
        <t:modificationType>add</t:modificationType>
        <t:path>c:defaultObjectPolicyConfiguration</t:path>
        <t:value>
            <type>RoleType</type>
            <expressionProfile>permissive</expressionProfile>
        </t:value>
        <t:value>
            <type>ObjectCollectionType</type>
            <expressionProfile>permissive</expressionProfile>
        </t:value>
        <t:value>
            <type>AccessCertificationDefinitionType</type>
            <expressionProfile>permissive</expressionProfile>
        </t:value>
        <t:value>
            <type>AccessCertificationCampaignType</type>
            <expressionProfile>permissive</expressionProfile>
        </t:value>
        <t:value>
            <type>ReportType</type>
            <expressionProfile>permissive</expressionProfile>
        </t:value>
        <t:value>
            <type>ObjectTemplateType</type>
            <expressionProfile>permissive</expressionProfile>
        </t:value>
        <t:value>
            <type>SystemConfigurationType</type>
            <expressionProfile>permissive</expressionProfile>
        </t:value>
    </apti:itemDelta>
</apti:objectModification>
