            <indexed>
                <objectType>UserType</objectType>
                <item>fullName</item>
                <item>emailAddress</item>
                <item>personalNumber</item>
            </indexed>
            <indexed>
                <objectType>AbstractRoleType</objectType>
                <item>displayName</item>
                <item>identifier</item>
            </indexed>
        </t:value>
    </apti:itemDelta>
