    <apti:oid>00000000-0000-0000-0000-000000000001</apti:oid>
    <apti:itemDelta>
        <t:modificationType>replace</t:modificationType>
        <t:path>c:adminGuiConfiguration/c:accessRequest</t:path>
        <t:value xsi:type="c:AccessRequestType">
            <roleCatalog>
                <defaultView>table</defaultView>
                <allowedViews>table</allowedViews>
                <allowedViews>tile</allowedViews>
                <roleCatalogRef oid="00000000-8888-6666-0000-100000000001" relation="org:default" type="c:OrgType"/>
                <collection>
                    <identifier>all-roles</identifier>
                    <collectionRef oid="aac103d7-0078-4d34-b494-e367164f0fbb" relation="org:default" type="c:ObjectCollectionType"/>
                </collection>
                <collection>
                    <identifier>allOrgs</identifier>
                    <collectionIdentifier>allOrgs</collectionIdentifier>
                </collection>
                <collection>
                    <identifier>allServices</identifier>
                    <collectionIdentifier>allServices</collectionIdentifier>
                </collection>
            </roleCatalog>
        </t:value>
    </apti:itemDelta>
    <apti:itemDelta>
        <t:modificationType>add</t:modificationType>
        <t:path>c:fullTextSearch</t:path>
        <t:value xsi:type="c:FullTextSearchConfigurationType">
