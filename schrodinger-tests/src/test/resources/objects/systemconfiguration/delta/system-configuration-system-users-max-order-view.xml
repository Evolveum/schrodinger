                        <displayOrder>20</displayOrder>
                    </searchItem>
                    <searchItem>
                        <path>familyName</path>
                        <display>
                            <label>Family Name</label>
                        </display>
                        <visibleByDefault>true</visibleByDefault>
                        <displayOrder>10</displayOrder>
                    </searchItem>
                    <searchItem>
                        <path>emailAddress</path>
