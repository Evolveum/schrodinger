<!-- Applied on top of the initial system configuration, see AbstractSchrodingerTest.applySystemConfiguration(). -->
<apti:objectModification xmlns:apti="http://midpoint.evolveum.com/xml/ns/public/common/api-types-3" xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3" xmlns:c="http://midpoint.evolveum.com/xml/ns/public/common/common-3" xmlns:org="http://midpoint.evolveum.com/xml/ns/public/common/org-3" xmlns:q="http://prism.evolveum.com/xml/ns/public/query-3" xmlns:t="http://prism.evolveum.com/xml/ns/public/types-3" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <apti:oid>00000000-0000-0000-0000-000000000001</apti:oid>
    <apti:itemDelta>
        <t:modificationType>add</t:modificationType>
        <t:path>c:adminGuiConfiguration/c:objectCollectionViews/c:objectCollectionView[80]/c:searchBoxConfiguration/c:allowToConfigureSearchItems</t:path>
        <t:value xmlns:xsd="http://www.w3.org/2001/XMLSchema" xsi:type="xsd:boolean">false</t:value>
    </apti:itemDelta>
    <apti:itemDelta>
        <t:modificationType>add</t:modificationType>
        <t:path>c:adminGuiConfiguration/c:objectCollectionViews/c:objectCollectionView</t:path>
        <t:value xsi:type="c:GuiObjectListViewType">
            <identifier>allUsers</identifier>
            <searchBoxConfiguration>
                <searchItems>
                    <searchItem>
                        <filterExpression>
                            <script>
                                <code>
                import com.evolveum.midpoint.xml.ns._public.common.common_3.UserType
                import com.evolveum.midpoint.prism.path.ItemPath
                import javax.xml.namespace.QName

                if (valueParam == null || valueParam.isEmpty()) {
                    return null
                }

                def NS_EXT = "http://midpoint.evolveum.com/xml/ns/samples/gen"

                def path = ItemPath.create(
                        UserType.F_EXTENSION,
                        new QName(NS_EXT, "middleName")
                );

                def filter = prismContext
                        .queryFor(UserType.class)
                        .item(path).eq(valueParam)
                        .buildFilter()

                return prismContext.getQueryConverter().createSearchFilterType(filter)
            </code>
                            </script>
                        </filterExpression>
                        <display>
                            <label>Middle name</label>
                        </display>
                        <parameter>
                            <name>valueParam</name>
                            <type>string</type>
                            <allowedValuesExpression>
                                <script>
                                    <code>
                    import com.evolveum.midpoint.gui.impl.component.search.SearchValue
                    import com.evolveum.midpoint.util.DisplayableValue

                    List&lt;DisplayableValue&gt; list = new ArrayList&lt;&gt;()

                    list.add(new SearchValue("michael", "Michael"))
                    list.add(new SearchValue("jack", "Jack"))

                    return list
                </code>
                                </script>
                            </allowedValuesExpression>
                        </parameter>
                    </searchItem>
                </searchItems>
            </searchBoxConfiguration>
            <type>UserType</type>
        </t:value>
    </apti:itemDelta>
    <apti:itemDelta>
        <t:modificationType>add</t:modificationType>
        <t:path>c:adminGuiConfiguration/c:objectDetails/c:objectDetailsPage</t:path>
        <t:value xsi:type="c:GuiObjectDetailsPageType">
            <type>OrgType</type>
            <panel>
                <identifier>orgMembers</identifier>
                <listView>
                    <searchBoxConfiguration>
                        <objectTypeConfiguration>
                            <supportedTypes>OrgType</supportedTypes>
                            <supportedTypes>RoleType</supportedTypes>
                            <supportedTypes>UserType</supportedTypes>
                        </objectTypeConfiguration>
                    </searchBoxConfiguration>
                </listView>
            </panel>
        </t:value>
    </apti:itemDelta>
</apti:objectModification>
